# ============================================================
# Uzbekistan Economic Monitor — Backend Environment Variables
# ============================================================
# Bu faylni .env deb nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uzbekistan_econ
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- FastAPI ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_LOG_LEVEL=info

# --- Scheduler ---
FETCH_INTERVAL_MINUTES=60

# --- External APIs ---
# Open Exchange Rates (openexchangerates.org da bepul ro'yxatdan o'ting)
OPEN_EXCHANGE_RATES_APP_ID=your_app_id_here

# World Bank API (kalit talab qilinmaydi)
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# CBU (Markaziy Bank) kurs endpointi (kalit talab qilinmaydi)
CBU_RATES_URL=https://cbu.uz/en/arkhiv-kursov-valyut/json/

# --- CORS (frontend manzili) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
